#!/bin/bash
# hpm-lite: simple apt wrapper that containerizes Kali/Parrot/BlackArch packages

set -euo pipefail

APT_BIN="${APT_BIN:-apt}"
HPM_USER="${SUDO_USER:-$USER}"
HPM_HOME="$(getent passwd "$HPM_USER" | cut -d: -f6)"
container_init() {
    echo "[$HPM_NAME] Importing images from $HPM_HOME/.hpm/images" >&2

    run_podman import "$HPM_HOME/.hpm/images/kali.tar"      hpm/kali
    run_podman import "$HPM_HOME/.hpm/images/parrot.tar"    hpm/parrot
    run_podman import "$HPM_HOME/.hpm/images/blackarch.tar" hpm/blackarch

    echo "[$HPM_NAME] Creating containers hpm-kali / hpm-parrot / hpm-blackarch" >&2

    run_podman run -d --name hpm-kali      hpm/kali      sleep infinity
    run_podman run -d --name hpm-parrot    hpm/parrot    sleep infinity
    run_podman run -d --name hpm-blackarch hpm/blackarch sleep infinity
}

run_podman() {
    if [[ "$(id -u)" -eq 0 ]]; then
        # We are root (sudo hpm) \E2\86\92 run podman as original user
        sudo -u "$HPM_USER" podman "$@"
    else
        # Normal user
        podman "$@"
    fi
}

get_repo_type() {
    local pkg="$1"
    local info

    if ! info="$(${APT_BIN}-cache policy "$pkg" 2>/dev/null)"; then
        echo "unknown"
        return
    fi

    if grep -qi 'kali' <<<"$info"; then
        echo "kali"
    elif grep -qi 'parrot' <<<"$info"; then
        echo "parrot"
    elif grep -qi 'blackarch' <<<"$info"; then
        echo "blackarch"
    elif grep -qi 'debian' <<<"$info"; then
        echo "debian"
    else
        echo "unknown"
    fi
}
ensure_container() {
    local repo_type="$1"
    local cname
    cname="$(get_container_name "$repo_type")"

    if [[ -z "$cname" ]]; then
        echo "[hpm-lite] No container name for repo type '$repo_type'" >&2
        return 1
    fi

    if ! command -v podman >/dev/null 2>&1; then
        echo "[hpm-lite] podman not found" >&2
        return 1
    fi

    if run_podman container exists "$cname" >/dev/null 2>&1; then
        return 0
    else
        echo "[hpm-lite] container not found: $cname" >&2
        return 1
    fi
}

get_container_name() {
    case "$1" in
        kali)      echo "hpm-kali";;
        parrot)    echo "b391ea101dc7" ;;
        blackarch) echo "d4f95179a2f1" ;;
        *)         echo "" ;;
    esac
}

get_container_image() {
    case "$1" in
        kali)      echo "kalilinux/kali-rolling" ;;
        parrot)    echo "parrotsec/core" ;;
        blackarch) echo "blackarch/blackarch" ;;
        *)         echo "" ;;
    esac
}

install_one() {
    local pkg="$1"

    local repo_type
    repo_type="$(get_repo_type "$pkg")"

    if [[ "$repo_type" == "debian" || "$repo_type" == "unknown" ]]; then
        echo "[hpm-lite] Installing '$pkg' on host (repo: $repo_type)" >&2
        exec ${APT_BIN} install -y -V "$pkg"
    else
        local image cname
        image="$(get_container_image "$repo_type")"
        cname="$(get_container_name "$repo_type")"

        if [[ -z "$image" || -z "$cname" ]]; then
            echo "[hpm-lite] No image/container for repo type '$repo_type', falling back to host" >&2
            exec ${APT_BIN} install -y -V "$pkg"
        fi

        ensure_container "$repo_type"

        echo "[hpm-lite] Updating APT cache in container $cname (repo: $repo_type)" >&2
        run_podman exec -it --user root "$cname" ${APT_BIN} update -y

        echo "[hpm-lite] Installing '$pkg' in container $cname (repo: $repo_type)" >&2
        run_podman exec -it --user root "$cname" ${APT_BIN} install -y -V "$pkg"

        create_container_shim "$repo_type" "$pkg" || true
    fi
}
create_container_shim() {
    local repo_type="$1"
    local pkg="$2"

    local cname
    cname="$(get_container_name "$repo_type")" || return 1
    [[ -n "$cname" ]] || return 1

    local user_home
    if [[ -n "${SUDO_USER-}" ]]; then
        user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    else
        user_home="$HOME"
    fi

    local shim_dir="$user_home/.hpm/symlinks"
    mkdir -p "$shim_dir"

    local shim="$shim_dir/${pkg}"

    if [[ -e "$shim" ]]; then
        echo "[hpm-lite] shim already exists: $shim" >&2
        return 0
    fi

    cat >"$shim" <<EOF
#!/bin/bash
exec podman exec -it --user root "$cname" "$pkg" "\$@"
EOF

    chmod +x "$shim"
    echo "[hpm-lite] created shim: $shim -> podman exec -it --user root $cname $pkg" >&2
}

main() {
    if [[ "$#" -lt 1 ]]; then
        echo "Usage: $0 install <pkg> [...] | <any apt command>" >&2
        exit 1
    fi

    local cmd="$1"
    shift || true

    case "$cmd" in
     	init)
            container_init
            ;;
        install)
            if [[ "$#" -lt 1 ]]; then
                echo "Usage: $0 install <pkg> [...]" >&2
                exit 1
            fi
            # Simple case: treat all remaining args as package names
            local pkg
            for pkg in "$@"; do
                install_one "$pkg"
            done
            ;;
        *)
            # For everything else, just behave like apt
            exec ${APT_BIN} "$cmd" "$@"
            ;;
    esac
}

main "$@"
