#!/usr/bin/env bash
#
# hpm - Hood Package Manager
# Wraps apt to automatically containerize non-Debian packages
# Usage: sudo hpm install/remove <package>
set -euo pipefail
shopt -s nullglob

# Configuration
CONFIG_DIR="${HOME}/.hpm"
DB_FILE="${CONFIG_DIR}/packages.db"
CONTAINERS_DIR="${CONFIG_DIR}/containers"
LOG_FILE="${CONFIG_DIR}/hpm.log"
SYMLINK_DIR="/usr/local/bin"
APTOPTS="${APTOPTS:--y}"  # Default apt options

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Logging
log() {
    echo -e "${BLUE}[hpm]${NC} $*" | tee -a "$LOG_FILE"
}

error() {
    echo -e "${RED}[ERROR]${NC} $*" | tee -a "$LOG_FILE" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*" | tee -a "$LOG_FILE"
}

# Ensure running as root
ensure_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        error "This script must be run as root. Use sudo."
    fi
}

init_hpm() {
    mkdir -p "$CONFIG_DIR" "$CONTAINERS_DIR"
    touch "$DB_FILE" "$LOG_FILE"
    # Make sure log is writable by root
    : > "$LOG_FILE" || true
}

# Pick host apt command: prefer apt.real (if present), then apt-get, then apt
apt_host_cmd() {
    if command -v apt.real >/dev/null 2>&1; then
        echo "apt.real"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "apt-get"
    elif command -v apt >/dev/null 2>&1; then
        echo "apt"
    else
        error "No apt binary found on host."
    fi
}

# Check if package is from Debian repository
is_debian_package() {
    local package="$1"

    # If apt-cache show says Origin: Debian
    if apt-cache show "$package" 2>/dev/null | grep -q -i "Origin: Debian"; then
        return 0
    fi

    # If apt-cache policy identifies known non-debian repos (kali/parrot/blackarch)
    if apt-cache policy "$package" 2>/dev/null | grep -Eq 'kali|parrot|blackarch'; then
        return 1
    fi

    # Default conservative behavior: treat unknown packages as host-install
    return 0
}

# Get repository type from package (kali/blackarch/parrot/debian/empty)
get_repo_type() {
    local package="$1"

    apt-cache show "$package" 2>/dev/null | \
        grep -i 'origin\|archive' | \
        head -1 | \
        sed -e 's/.*[Kk]ali.*/kali/' \
            -e 's/.*[Bb]lackarch.*/blackarch/' \
            -e 's/.*[Pp]arrot.*/parrot/' \
            -e 's/Origin: Debian/debian/' \
            -e 's/.*[Dd]ebian.*/debian/' || true
}

# Get container image for repo type
get_container_image() {
    local repo_type="$1"

    case "$repo_type" in
        kali)      echo "docker.io/kalilinux/kali-rolling" ;;
        blackarch) echo "docker.io/blackarch/blackarch" ;;
        parrot)    echo "docker.io/parrotsec/core" ;;
        debian)    echo "" ;; # no container for Debian
        *)         echo "" ;;
    esac
}

# Ensure container exists and is running (returns container name)
ensure_container() {
    local repo_type="$1"
    local container_name
    local image

    container_name=$(get_container_name "$repo_type")
    image=$(get_container_image "$repo_type")

    if [ -z "$image" ]; then
        warn "No container image for repo type '$repo_type' — caller should handle fallback."
        return 1
    fi

    # If container exists
    if podman container exists "$container_name" 2>/dev/null; then
        if [ "$(podman inspect -f '{{.State.Status}}' "$container_name")" != "running" ]; then
            log "Starting container: $container_name"
            podman start "$container_name" >/dev/null
        fi
    else
        log "Creating container: $container_name from $image"
        podman run -d \
            --name "$container_name" \
            --hostname "hpm-$repo_type" \
            --volume /sys/fs/cgroup:/sys/fs/cgroup:ro \
            --volume /run/systemd:/run/systemd:ro \
            --tmpfs /tmp \
            --tmpfs /run \
            --cap-add=NET_ADMIN \
            --cap-add=SYS_ADMIN \
            --security-opt seccomp=unconfined \
            --security-opt label=disable \
            --network host \
            "$image" \
            /sbin/init >/dev/null

        # Small wait for container to initialize
        sleep 2
        # Update container packages (best-effort)
        podman exec "$container_name" apt-get update >/dev/null || true
    fi

    echo "$container_name"
}

get_container_name() {
    local repo_type="$1"
    echo "hpm-${repo_type}"
}

# Install package in container
install_in_container() {
    local container_name="$1"
    local package="$2"

    log "Installing $package in $container_name"

    # Update container repos
    podman exec "$container_name" apt-get update >/dev/null || true

    # Install package
    if podman exec "$container_name" apt-get install $APTOPTS "$package"; then
        # Record installation as: epoch:container:package
        echo "$(date +%s):${container_name}:$package" >> "$DB_FILE"
        return 0
    else
        return 1
    fi
}

# Find binaries in container
find_container_binaries() {
    local container_name="$1"
    local package="$2"

    podman exec "$container_name" dpkg -L "$package" 2>/dev/null | \
        grep -E '^/usr/bin/|^/usr/sbin/|^/usr/games/|^/bin/|^/sbin/' | \
        grep -v '/$' || true
}

# Create wrapper script in SYMLINK_DIR that executes binary inside container
create_symlink_wrapper() {
    local container_name="$1"
    local binary_path="$2"
    local binary_name
    local wrapper_path

    binary_name=$(basename "$binary_path")
    wrapper_path="${SYMLINK_DIR}/${binary_name}"

    if [ -L "$wrapper_path" ] || [ -f "$wrapper_path" ]; then
        warn "Binary $binary_name already exists in $SYMLINK_DIR, skipping..."
        return
    fi

    cat > "/tmp/hpm-wrapper-${binary_name}" <<-EOF
	#!/bin/bash
	# hpm wrapper for $binary_name
	# Container: $container_name

	exec podman exec "$container_name" "$binary_path" "\$@"
	EOF

    mv "/tmp/hpm-wrapper-${binary_name}" "$wrapper_path"
    chmod +x "$wrapper_path"

    log "Created wrapper: $binary_name → $container_name"
}

# Remove package from container
remove_from_container() {
    local container_name="$1"
    local package="$2"

    log "Removing $package from $container_name"

    # Remove package
    podman exec "$container_name" apt-get remove $APTOPTS "$package" || true

    # Clean up database entry (matching last :container:package)
    if [ -f "$DB_FILE" ]; then
        grep -v ":${container_name}:${package}$" "$DB_FILE" > "${DB_FILE}.tmp" || true
        mv "${DB_FILE}.tmp" "$DB_FILE" || true
    fi

    # Clean up symlinks
    remove_symlinks "$container_name" "$package"
}

# Remove symlinks for package
remove_symlinks() {
    local container_name="$1"
    local package="$2"

    local binaries
    binaries=$(find_container_binaries "$container_name" "$package" || true)

    for binary in $binaries; do
        local binary_name wrapper_path
        binary_name=$(basename "$binary")
        wrapper_path="${SYMLINK_DIR}/${binary_name}"

        if [ -f "$wrapper_path" ]; then
            # Check if wrapper is ours
            if head -1 "$wrapper_path" | grep -q "hpm wrapper"; then
                rm -f "$wrapper_path"
                log "Removed wrapper: $binary_name"
            fi
        fi
    done
}

# Main install function
hpm_install() {
    local packages=("$@")
    local aptcmd
    aptcmd="$(apt_host_cmd)"

    for package in "${packages[@]}"; do
        log "Processing: $package"

        if is_debian_package "$package"; then
            log "Installing Debian package on host: $package"
            $aptcmd install $APTOPTS "$package"
            continue
        fi

        local repo_type
        repo_type=$(get_repo_type "$package" || true)
        repo_type="${repo_type:-unknown}"
        image=$(get_container_image "$repo_type" || true)

        if [ -z "$image" ]; then
            warn "Could not determine a container image for repo type '$repo_type'. Falling back to host install for $package."
            $aptcmd install $APTOPTS "$package"
            continue
        fi

        local container_name
        container_name=$(ensure_container "$repo_type")
        if [ -z "$container_name" ]; then
            error "Failed to ensure container for repo type '$repo_type'"
        fi

        if install_in_container "$container_name" "$package"; then
            local binaries
            binaries=$(find_container_binaries "$container_name" "$package")
            for binary in $binaries; do
                create_symlink_wrapper "$container_name" "$binary"
            done
        else
            error "Failed to install $package in container $container_name"
        fi
    done
}

# Main remove function
hpm_remove() {
    local packages=("$@")
    local aptcmd
    aptcmd="$(apt_host_cmd)"

    for package in "${packages[@]}"; do
        # Look up DB for containerized package (format: epoch:container:package)
        if grep -q ":${package}$" "$DB_FILE" 2>/dev/null || true; then
            local container_entry
            container_entry=$(grep ":${package}$" "$DB_FILE" | head -1 || true)

            # container is second colon-separated field; robust to timestamps in first field
            local container_name
            container_name=$(echo "$container_entry" | awk -F: '{print $(NF-1)}' | tr -d ' ')

            if [ -n "$container_name" ]; then
                remove_from_container "$container_name" "$package"
                continue
            fi
        fi

        # Otherwise assume host package
        log "Removing host package: $package"
        $aptcmd remove $APTOPTS "$package"
    done
}

# List containerized packages
list_containerized() {
    echo -e "${BLUE}Containerized packages:${NC}"
    if [ -s "$DB_FILE" ]; then
        column -t -s: "$DB_FILE" || cat "$DB_FILE"
    else
        echo "No containerized packages found"
    fi
}

# Show container status
container_status() {
    echo -e "${BLUE}Container Status:${NC}"
    podman ps -a --filter "name=hpm-*" --format "table {{.Names}}\t{{.Status}}\t{{.Image}}"
}

# Cleanup orphaned wrappers
cleanup_symlinks() {
    echo -e "${BLUE}Checking for orphaned wrappers...${NC}"

    for wrapper in "${SYMLINK_DIR}"/*; do
        if [ -f "$wrapper" ] && head -1 "$wrapper" 2>/dev/null | grep -q "hpm wrapper"; then
            # Header line format: "# Container: <container_name>"
            # Extract third field to get the container name
            container_name=$(grep "Container:" "$wrapper" | awk '{print $3}' || true)

            if [ -n "$container_name" ] && ! podman container exists "$container_name" 2>/dev/null; then
                echo "Removing orphaned wrapper: $(basename "$wrapper")"
                rm -f "$wrapper"
            fi
        fi
    done
}

# Help function
show_help() {
    cat << EOF
hpm - Hood Package Manager

Usage:
  hpm install <package>...    Install packages (auto-containerize non-Debian)
  hpm remove <package>...     Remove packages
  hpm list-containerized      Show containerized packages
  hpm container-status        Show container status
  hpm cleanup                 Remove orphaned wrappers
  hpm help                    Show this help

Notes:
  - Run this script as root (sudo).
  - Podman must be installed and configured on the host to use containerized packages.
  - This script attempts to detect Kali/Parrot/BlackArch packages; if detection fails it will fall back to host install.
EOF
}

# Entrypoint
main() {
    ensure_root
    init_hpm

    local command="$1"
    shift || true

    case "$command" in
        install)
            [ $# -eq 0 ] && error "No packages specified"
            hpm_install "$@"
            ;;
        remove|uninstall)
            [ $# -eq 0 ] && error "No packages specified"
            hpm_remove "$@"
            ;;
        list-containerized)
            list_containerized
            ;;
        container-status)
            container_status
            ;;
        cleanup)
            cleanup_symlinks
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            # Pass through to real apt for other commands
            apt_host_cmd | xargs -I{} {} "$command" "$@"
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    [ $# -eq 0 ] && show_help && exit 0
    main "$@"
fi

