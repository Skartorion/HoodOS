#!/bin/bash
# hpm - HoodOS Package Manager (apt wrapper with container support)

set -euo pipefail

HPM_ROOT="${HOME}/.hpm"
HPM_LOG="${HPM_ROOT}/hpm.log"

mkdir -p "${HPM_ROOT}"

log() {
    printf '[hpm] %s\n' "$*" | tee -a "${HPM_LOG}" >&2
}

error() {
    printf '[hpm:ERROR] %s\n' "$*" | tee -a "${HPM_LOG}" >&2
    exit 1
}

require_root() {
    if [[ "$(id -u)" -ne 0 ]]; then
        error "hpm must be run as root"
    fi
}

get_apt_bin() {
    if command -v apt.real >/dev/null 2>&1; then
        printf '%s\n' apt.real
    elif command -v apt >/dev/null 2>&1; then
        printf '%s\n' apt
    else
        error "No apt binary found"
    fi
}

apt_host_cmd() {
    command "$(get_apt_bin)" "$@"
}

### Detect package repo type ###################################################

get_repo_type() {
    local pkg="$1"
    local info
    
    if ! info="$(apt-cache policy "$pkg" 2>/dev/null)"; then
        echo "unknown"
        return
    fi

    if grep -qi 'kali' <<<"${info}"; then
        echo "kali"
    elif grep -qi 'parrot' <<<"${info}"; then
        echo "parrot"
    elif grep -qi 'blackarch' <<<"${info}"; then
        echo "blackarch"
    elif grep -qi 'debian' <<<"${info}"; then
        echo "debian"
    else
        echo "unknown"
    fi
}

get_container_name() {
    case "$1" in
        kali)      echo "hoodos/kali" ;;
        parrot)    echo "hoodos/parrot" ;;
        blackarch) echo "hoodos/blackarch" ;;
        *)         echo "" ;;
    esac
}

### Core install logic ##########################################################

hpm_install_one() {
    local pkg="$1"
    local repo_type cname

    repo_type="$(get_repo_type "${pkg}")"
    cname="$(get_container_name "${repo_type}")"

    # If package is in kali/parrot/blackarch repo, install in container
    if [[ -n "${cname}" ]]; then
        log "Installing ${pkg} in container ${cname} (repo: ${repo_type})"
        
        if ! command -v podman >/dev/null 2>&1; then
            error "podman not found"
        fi
        
        podman exec "${cname}" apt-get install -y "${pkg}"
        return
    fi

    # Otherwise install on host (debian or unknown)
    log "Installing ${pkg} on host (repo: ${repo_type})"
    apt_host_cmd install "${pkg}"
}

hpm_install() {
    [[ "$#" -gt 0 ]] || error "Usage: hpm install <pkg> [...]"

    local pkg
    for pkg in "$@"; do
        hpm_install_one "${pkg}"
    done
}

### CLI dispatch ###############################################################

main() {
    require_root

    local aptcmd
    aptcmd="$(get_apt_bin)"

    # Separate global options from the subcommand and its args
    local opts=()
    local cmd=
    local args=()

    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat <<EOF
hpm - HoodOS Package Manager

Usage:
  hpm install <pkg> [...]     Install package (containerized for kali/parrot/blackarch)
  hpm [apt options] <cmd> ... Pass through to apt

EOF
                exec "${aptcmd}" "$@"
                ;; 

            -v|--version|-c|-o|-t|-y|--no-install-recommends)
                opts+=("$1")
                shift

                if [[ "$#" -eq 0 ]]; then
                    continue
                fi

                if [[ "${opts[-1]}" =~ ^(-c|-o|-t)$ ]]; then
                    if [[ "$#" -gt 0 && ! "$1" =~ ^- ]]; then
                        opts+=("$1")
                        shift
                    fi
                fi
                ;; 

            -*))
                opts+=("$1")
                shift
                ;; 

            *)
                cmd="$1"
                shift
                args=("$@")
                break
                ;; 
        esac
    done

    if [[ -z "${cmd}" ]]; then
        exec "${aptcmd}" "${opts[@]}"
    fi

    case "${cmd}" in
        install)
            hpm_install "${args[@]}"
            ;; 
        *)
            exec "${aptcmd}" "${opts[@]}" "${cmd}" "${args[@]}"
            ;; 
    esac
}

main "$@"