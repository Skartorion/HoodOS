#!/bin/bash
# hoodos (hybrid) package manager

set -euo pipefail

HPM_NAME="hpm"
HPM_VERSION="0.3.0"

APT_BIN="${APT_BIN:-apt}"
HPM_USER="${SUDO_USER:-$USER}"
HPM_HOME="$(getent passwd "$HPM_USER" | cut -d: -f6)"

run_podman() {
    if [[ "$(id -u)" -eq 0 ]]; then
        sudo -u "$HPM_USER" podman "$@"
    else
        podman "$@"
    fi
}

print_help() {
    cat <<EOF
$HPM_NAME $HPM_VERSION - Hybrid (HoodOS) Package Manager for automatic package containerization

Usage:
  hpm init		        Import images and create hpm-* containers
  hpm shell   [container]       Enter container with interactive shell (Kali/Parrot/Blackarch)
  hpm install [--repo R] <pkg>  Install packages (host or into appropriate container)
  hpm remove  [--repo R] <pkg>  Remove packages and associated shims
  hpm <apt-subcommand> [...]    Pass through to apt (e.g. hpm update, hpm search)

Options:
  -r, --repo R                  Force repo: kali, parrot, blackarch, debian
  -h, --help                    Show this help and exit
  -V, --version                 Show version and exit

Environment:
  APT_BIN                       Override apt binary (default: apt)

EOF
}

print_version() {
    echo "$HPM_NAME $HPM_VERSION"
}

normalize_repo() {
    # map user input to canonical repo_type or empty if invalid
    local r
    r="$(tr '[:upper:]' '[:lower:]' <<<"$1")"
    case "$r" in
        kali|k)       echo "kali" ;;
        parrot|p)     echo "parrot" ;;
        blackarch|ba) echo "blackarch" ;;
        debian|d)     echo "debian" ;;
        *)            echo "" ;;
    esac
}

get_repo_type() {
    local pkg="$1"
    local info

    if ! info="$(${APT_BIN}-cache policy "$pkg" 2>/dev/null)"; then
        echo "unknown"
        return
    fi

    if grep -qi 'kali' <<<"$info"; then
        echo "kali"
    elif grep -qi 'parrot' <<<"$info"; then
        echo "parrot"
    elif grep -qi 'blackarch' <<<"$info"; then
        echo "blackarch"
    elif grep -qi 'debian' <<<"$info"; then
        echo "debian"
    else
        echo "unknown"
    fi
}

get_container_name() {
    case "$1" in
        kali)      echo "hpm-kali" ;;
        parrot)    echo "hpm-parrot" ;;
        blackarch) echo "hpm-blackarch" ;;
        *)         echo "" ;;
    esac
}

get_container_image() {
    case "$1" in
        kali)      echo "hpm/kali" ;;
        parrot)    echo "hpm/parrot" ;;
        blackarch) echo "hpm/blackarch" ;;
        *)         echo "" ;;
    esac
}

ensure_container() {
    local repo_type="$1"
    local cname
    cname="$(get_container_name "$repo_type")"

    if [[ -z "$cname" ]]; then
        echo "[$HPM_NAME] No container name for repo type '$repo_type'" >&2
        return 1
    fi

    if ! command -v podman >/dev/null 2>&1; then
        echo "[$HPM_NAME] podman not found" >&2
        return 1
    fi

    if run_podman container exists "$cname" >/dev/null 2>&1; then
        return 0
    else
        echo "[$HPM_NAME] container not found: $cname" >&2
        return 1
    fi
}

create_container_shim() {
    local repo_type="$1"
    local pkg="$2"

    local cname
    cname="$(get_container_name "$repo_type")" || return 1
    [[ -n "$cname" ]] || return 1

    local user_home
    if [[ -n "${SUDO_USER-}" ]]; then
        user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    else
        user_home="$HOME"
    fi

    local shim_dir="$user_home/.hpm/symlinks"
    mkdir -p "$shim_dir"

    local shim="$shim_dir/${pkg}"

    if [[ -e "$shim" ]]; then
        echo "[$HPM_NAME] shim already exists: $shim" >&2
        return 0
    fi

    cat >"$shim" <<EOF
#!/bin/bash
exec podman exec -it --user root "$cname" "$pkg" "\$@"
EOF

    chmod +x "$shim"
    echo "[$HPM_NAME] created shim: $shim -> podman exec -it --user root $cname $pkg" >&2
}

remove_container_shim() {
    local pkg="$1"

    local user_home
    if [[ -n "${SUDO_USER-}" ]]; then
        user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    else
        user_home="$HOME"
    fi

    local shim="$user_home/.hpm/symlinks/${pkg}"
    if [[ -e "$shim" ]]; then
        rm -f "$shim"
        echo "[$HPM_NAME] removed shim: $shim" >&2
    fi
}

get_remove_cmd() {
    local repo_type="$1"
    local pkg="$2"

    case "$repo_type" in
        kali|parrot|debian)
            echo "${APT_BIN} remove -y $pkg"
            ;;
        blackarch)
            echo "pacman -R --noconfirm $pkg"
            ;;
        *)
            echo "${APT_BIN} remove -y $pkg"
            ;;
    esac
}

# BlackArch-specific install path using pacman
ba_install_one() {
    local pkg="$1"
    local repo_type="blackarch"
    local cname
    cname="$(get_container_name "$repo_type")"

    if [[ -z "$cname" ]]; then
        echo "[$HPM_NAME] No container name for repo type '$repo_type'" >&2
        return 1
    fi

    ensure_container "$repo_type"

    echo "[$HPM_NAME] Updating pacman db in container $cname (repo: $repo_type)" >&2
    run_podman exec -it --user root "$cname" pacman -Suy --noconfirm

    echo "[$HPM_NAME] Checking if '$pkg' exists in BlackArch repos" >&2
    if ! run_podman exec -it --user root "$cname" pacman -Si "$pkg" >/dev/null 2>&1; then
        echo "[$HPM_NAME] Package '$pkg' not found in BlackArch repos" >&2
        return 1
    fi

    echo "[$HPM_NAME] Installing '$pkg' in container $cname (repo: $repo_type)" >&2
    run_podman exec -it --user root "$cname" pacman -S --noconfirm "$pkg"

    create_container_shim "$repo_type" "$pkg" || true
}

install_one() {
    local pkg="$1"
    local forced_repo="${2:-}"

    local repo_type

    if [[ -n "$forced_repo" ]]; then
        repo_type="$(normalize_repo "$forced_repo")"
        if [[ -z "$repo_type" ]]; then
            echo "[$HPM_NAME] Invalid repo: $forced_repo (use kali, parrot, blackarch, debian)" >&2
            return 1
        fi
    else
        repo_type="$(get_repo_type "$pkg")"
    fi

    if [[ "$repo_type" == "blackarch" ]]; then
        ba_install_one "$pkg"
        return
    fi

    if [[ "$repo_type" == "debian" || "$repo_type" == "unknown" ]]; then
        echo "[$HPM_NAME] Installing '$pkg' on host (repo: $repo_type)" >&2
        exec ${APT_BIN} install -y -V "$pkg"
    else
        local image cname
        image="$(get_container_image "$repo_type")"
        cname="$(get_container_name "$repo_type")"

        if [[ -z "$image" || -z "$cname" ]]; then
            echo "[$HPM_NAME] No image/container for repo type '$repo_type', falling back to host" >&2
            exec ${APT_BIN} install -y -V "$pkg"
        fi

        ensure_container "$repo_type"

        echo "[$HPM_NAME] Updating APT cache in container $cname (repo: $repo_type)" >&2
        run_podman exec -it --user root "$cname" ${APT_BIN} update -y

        echo "[$HPM_NAME] Installing '$pkg' in container $cname (repo: $repo_type)" >&2
        run_podman exec -it --user root "$cname" ${APT_BIN} install -y -V "$pkg"

        create_container_shim "$repo_type" "$pkg" || true
    fi
}

remove_one() {
    local pkg="$1"
    local forced_repo="${2:-}"

    local repo_type

    if [[ -n "$forced_repo" ]]; then
        repo_type="$(normalize_repo "$forced_repo")"
        if [[ -z "$repo_type" ]]; then
            echo "[$HPM_NAME] Invalid repo: $forced_repo (use kali, parrot, blackarch, debian)" >&2
            return 1
        fi
    else
        repo_type="$(get_repo_type "$pkg")"
    fi

    if [[ "$repo_type" == "debian" || "$repo_type" == "unknown" ]]; then
        echo "[$HPM_NAME] Removing '$pkg' from host (repo: $repo_type)" >&2
        ${APT_BIN} remove -y "$pkg"
        remove_container_shim "$pkg"
    else
        local cname
        cname="$(get_container_name "$repo_type")"

        if [[ -z "$cname" ]]; then
            echo "[$HPM_NAME] No container name for repo type '$repo_type', falling back to host remove" >&2
            ${APT_BIN} remove -y "$pkg"
            remove_container_shim "$pkg"
            return
        fi

        ensure_container "$repo_type"

        local remove_cmd
        remove_cmd="$(get_remove_cmd "$repo_type" "$pkg")"

        echo "[$HPM_NAME] Removing '$pkg' in container $cname (repo: $repo_type)" >&2
        run_podman exec -it --user root "$cname" bash -lc "$remove_cmd"

        remove_container_shim "$pkg"
    fi
}

container_init() {
    echo "[$HPM_NAME] Importing images from $HPM_HOME/.hpm/images" >&2

    run_podman import "$HPM_HOME/.hpm/images/kali.tar"      hpm/kali
    run_podman import "$HPM_HOME/.hpm/images/parrot.tar"    hpm/parrot
    run_podman import "$HPM_HOME/.hpm/images/blackarch.tar" hpm/blackarch

    echo "[$HPM_NAME] Creating containers hpm-kali / hpm-parrot / hpm-blackarch" >&2

    run_podman run -d --name hpm-kali      hpm/kali      sleep infinity
    run_podman run -d --name hpm-parrot    hpm/parrot    sleep infinity
    run_podman run -d --name hpm-blackarch hpm/blackarch sleep infinity
}

shell_into_container() {
    local name="$1"

    if [[ -z "$name" ]]; then
        echo "[$HPM_NAME] Usage: hpm shell <kali|parrot|blackarch>" >&2
        return 1
    fi

    local repo_type
    repo_type="$(normalize_repo "$name")"
    if [[ -z "$repo_type" || "$repo_type" == "debian" ]]; then
        echo "[$HPM_NAME] Invalid shell target: $name" >&2
        return 1
    fi

    local cname
    cname="$(get_container_name "$repo_type")"
    if [[ -z "$cname" ]]; then
        echo "[$HPM_NAME] No container for repo '$repo_type'" >&2
        return 1
    fi

    ensure_container "$repo_type"

    echo "[$HPM_NAME] Entering shell in container $cname (repo: $repo_type)" >&2
    run_podman exec -it --user root "$cname" /bin/bash
}

main() {
    if [[ "$#" -lt 1 ]]; then
        print_help >&2
        exit 1
    fi

    case "$1" in
        -h|--help)
            print_help
            exit 0
            ;;
        -V|--version)
            print_version
            exit 0
            ;;
    esac

    local cmd="$1"
    shift || true

    case "$cmd" in
        init)
            container_init
            ;;
	shell)
		if [[ "$#" -lt 1 ]]; then
			echo "Usage: hpm shell <kali|parrot|blackarch>" >&2
			exit 1
		fi
		shell_into_container "$1"
		;;
        install)
            if [[ "$#" -lt 1 ]]; then
                echo "Usage: hpm install [--repo R] <pkg> [...]" >&2
                exit 1
            fi
            local forced_repo=""
            # parse optional --repo/-r before pkgs
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    -r|--repo)
                        shift
                        [[ "$#" -gt 0 ]] || { echo "[$HPM_NAME] --repo requires an argument" >&2; exit 1; }
                        forced_repo="$1"
                        shift
                        break
                        ;;
                    --)
                        shift
                        break
                        ;;
                    *)
                        break
                        ;;
                esac
            done
            local pkg
            for pkg in "$@"; do
                install_one "$pkg" "$forced_repo"
            done
            ;;
        remove|uninstall)
            if [[ "$#" -lt 1 ]]; then
                echo "Usage: hpm remove [--repo R] <pkg> [...]" >&2
                exit 1
            fi
            local forced_repo=""
            while [[ "$#" -gt 0 ]]; do
                case "$1" in
                    -r|--repo)
                        shift
                        [[ "$#" -gt 0 ]] || { echo "[$HPM_NAME] --repo requires an argument" >&2; exit 1; }
                        forced_repo="$1"
                        shift
                        break
                        ;;
                    --)
                        shift
                        break
                        ;;
                    *)
                        break
                        ;;
                esac
            done
            local pkg
            for pkg in "$@"; do
                remove_one "$pkg" "$forced_repo"
            done
            ;;
        *)
            exec ${APT_BIN} "$cmd" "$@"
            ;;
    esac
}

# meow
main "$@"
