/* === Global text color === */
QLabel,
QPushButton,
QLineEdit,
QComboBox,
QSpinBox,
QTreeView,
QListView {
    color: #d3c6aa;
}

/* Sidebar step list */
#sidebarApp {
    color: #d3c6aa;
}

/* Welcome headline */
#welcomeLabel {
    color: #d3c6aa;
}


/* === Main window / pages === */

/* Outer Calamares window */
QWidget#calamaresWindow {
    background-color: #2b3339;
}

/* Main page area inside Calamares */
QWidget#calamaresWindow > QWidget {
    background-color: #2d353b;
    color: #d3c6aa;
}

/* Dialog background */
QDialog {
    background-color: #2d353b;
    color: #d3c6aa;
}


/* === Buttons === */

QPushButton {
    background-color: #2d353b;
    color: #d3c6aa;
    border-radius: 3px;
    border: 1px solid #475258;
    padding: 4px 10px;
}

QPushButton:hover {
    background-color: #343e44;
}

QPushButton:pressed {
    background-color: #232a2f;
}


/* === Inputs & combos === */

/* Combo boxes (e.g. language selector) */
QComboBox {
    background-color: #2d353b;
    color: #d3c6aa;
    border-radius: 3px;
    border: 1px solid #475258;
    padding: 2px 6px;
}

/* Drop‑down list items */
QComboBox QAbstractItemView {
    background-color: #2d353b;
    color: #d3c6aa;
    border: 1px solid #475258;
}

/* Line edits, spinboxes, etc. */
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #2d353b;
    color: #d3c6aa;
    border-radius: 3px;
    border: 1px solid #475258;
}


/* === Lists, trees, scrollbars === */

/* Language / keyboard lists etc. */
QListView {
    background-color: #2d353b;
    color: #d3c6aa;
    border: 1px solid #475258;
}

QListView::item:selected {
    background-color: #343e44;
    color: #d3c6aa;
}

/* Partition “Current” tree at bottom */
QTreeView {
    background-color: #2d353b;
    color: #d3c6aa;
    border: 1px solid #475258;
}

QTreeView::item:selected {
    background-color: #343e44;
    color: #d3c6aa;
}

/* Scrollbars */
QScrollBar:vertical,
QScrollBar:horizontal {
    background: #2d353b;
    border: 1px solid #475258;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #475258;
    border-radius: 4px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: #2d353b;
    border: none;
}


/* === Frames / groups === */

QGroupBox,
QFrame {
    background-color: #2d353b;
    color: #d3c6aa;
}

/* Labels inside frames & groups */
QGroupBox QLabel,
QFrame QLabel {
    color: #d3c6aa;
}
/* Nuke any remaining light backgrounds inside pages */
QWidget#calamaresWindow QWidget,
QWidget#calamaresWindow QFrame,
QWidget#calamaresWindow QGroupBox {
    background-color: #2d353b;
    color: #d3c6aa;
}

